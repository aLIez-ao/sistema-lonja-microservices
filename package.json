{
  "name": "sistema-lonja",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "client",
    "contracts"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "npm start -w @lonja/api",
    "dev": "concurrently -k \"npm run dev -w @lonja/api\" \"npm run dev -w @lonja/client\"",
    "test": "npm test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"{api,client,contracts,tools}/**/*.{js,json,yaml}\" package.json eslint.config.js \".github/workflows/*.yml\" \"compose*.yaml\"",
    "format:check": "prettier --check \"{api,client,contracts,tools}/**/*.{js,json,yaml}\" package.json eslint.config.js \".github/workflows/*.yml\" \"compose*.yaml\"",
    "migrar": "npm run migrar -w @lonja/api",
    "migrar:revertir": "npm run migrar:revertir -w @lonja/api --",
    "backup": "npm run backup -w @lonja/api",
    "backup:probar": "npm run backup:probar -w @lonja/api --",
    "demo": "npm run demo -w @lonja/api --",
    "correo:configurar": "npm run correo:configurar -w @lonja/api",
    "setup:git": "node tools/configurar-git.js",
    "docs:api": "node tools/documentar-api.js",
    "docs:check": "node tools/verificar-documentacion.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^12.0.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "sqlite3": "^6.0.1",
    "yaml": "^2.9.1"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
