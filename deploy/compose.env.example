# Configuración pública de Compose. Las claves viven en archivos Docker secrets.
DOMINIO=localhost
REGISTRO=ghcr.io/aliez-ao
VERSION=local
# Puertos publicados solo por compose.dev.yaml (los internos no cambian).
DEV_CLIENT_PORT=3000
DEV_API_PORT=2900
DEV_BD_PORT=3307
DEV_MAIL_PORT=8025
DEV_ADMINER_PORT=8080
ADMIN_USER=admin
GMAIL_USER=
# Alternativa de correo transaccional; completa los valores reales antes de publicar.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_FROM=
# SECRETO_SMTP_PASS=/etc/lonja/secrets/smtp_pass
PRIVACIDAD_RESPONSABLE=
PRIVACIDAD_DOMICILIO=
PRIVACIDAD_CONTACTO=
