<!-- Hoja carta con la misma distribución, medidas (pt) y tipografía que api/shared/helpers/facturaPdf.js -->
<div class="hoja-visor">
  <article class="hoja-carta factura">
    <header class="factura-encabezado">
      <div>
        <img class="factura-logo" src="/img/logo.svg" alt="Lonja de Veracruz" width="223" height="46">
        <div class="factura-lema"><%= f.emisor.lema %></div>
        <div class="factura-emisor">
          RFC: <%= f.emisor.rfc %> &nbsp;·&nbsp; <%= f.emisor.regimen %><br>
          <%= f.emisor.direccion %><br>
          <%= f.emisor.contacto %>
        </div>
      </div>
      <div class="factura-folio">
        <div class="factura-folio-titulo">FACTURA COMERCIAL</div>
        <div class="factura-folio-fila borde"><span>FOLIO</span><strong><%= f.folio %></strong></div>
        <div class="factura-folio-fila <%= f.pedido ? 'borde' : '' %>"><span>FECHA</span><em><%= f.fecha %></em></div>
        <% if (f.pedido) { %><div class="factura-folio-fila"><span>PEDIDO</span><em><%= f.pedido %></em></div><% } %>
      </div>
    </header>

    <div class="factura-tarjetas">
      <section class="factura-tarjeta">
        <div class="factura-tarjeta-titulo">FACTURADO A</div>
        <div class="factura-tarjeta-nombre"><a class="enlace-registro"
            href="/compradores/<%= compra.comprador.codigo_cpr %>"><%= f.cliente.nombre %></a></div>
        <div><span>Código de comprador: </span>#<%= f.cliente.codigo %></div>
        <div><span>Correo: </span><%= f.cliente.correo %></div>
        <div><span>Uso CFDI: </span><%= f.cliente.usoCfdi %></div>
      </section>
      <section class="factura-tarjeta">
        <div class="factura-tarjeta-titulo">ENTREGA Y PAGO</div>
        <div class="factura-tarjeta-nombre"><%= f.canal %></div>
        <div><span>Dirección: </span><%= f.cliente.direccion %></div>
        <div><span>Método de pago: </span><%= f.cliente.metodoPago %></div>
        <div><span>Moneda: </span>MXN</div>
      </section>
    </div>

    <table class="hoja-tabla factura-tabla">
      <colgroup>
        <col class="factura-col-lote">
        <col class="factura-col-descripcion">
        <col class="factura-col-cajas">
        <col class="factura-col-peso">
        <col class="factura-col-salida">
        <col class="factura-col-final">
        <col class="factura-col-total">
      </colgroup>
      <thead>
        <tr>
          <th>LOTE</th>
          <th>ESPECIES / DESCRIPCIÓN</th>
          <th class="der">CAJAS</th>
          <th class="der">PESO (KG)</th>
          <th class="der">SALIDA/KG</th>
          <th class="der">FINAL/KG</th>
          <th class="der">TOTAL</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="fuerte marino"><a class="enlace-registro"
              href="/lotes/<%= compra.id_cmp %>"><%= f.concepto.lote %></a></td>
          <td>
            <div class="fuerte"><%= f.concepto.especies %></div>
            <div class="nota"><%= f.concepto.nota %></div>
          </td>
          <td class="der"><%= f.concepto.cajas %></td>
          <td class="der"><%= f.concepto.kilos %></td>
          <td class="der tenue"><%= f.concepto.salida %></td>
          <td class="der fuerte"><%= f.concepto.final %></td>
          <td class="der fuerte marino"><%= f.concepto.total %></td>
        </tr>
      </tbody>
    </table>

    <section class="factura-resumen">
      <div class="factura-notas">
        <div class="factura-tarjeta-titulo">IMPORTE CON LETRA</div>
        <div class="factura-letra"><%= f.importeLetra %></div>
        <div class="factura-tarjeta-titulo">INFORMACIÓN FISCAL Y GARANTÍA</div>
        <% f.notasFiscales.forEach(n => { %><div>•&nbsp; <%= n %></div><% }) %>
      </div>
      <div class="factura-totales">
        <div class="fila"><span>Subtotal</span><b><%= f.subtotal %></b></div>
        <div class="fila"><span>IVA (0 %)</span><b><%= f.iva %></b></div>
        <div class="fila total"><span>TOTAL</span><strong><%= f.total %></strong></div>
      </div>
    </section>

    <footer class="factura-sello">
      <div class="etiqueta">CADENA ORIGINAL DEL COMPROBANTE DE SUBASTA:</div>
      <div class="mono"><%= f.cadena %></div>
      <div class="etiqueta">SELLO DIGITAL DE LA LONJA:</div>
      <div class="mono"><%= f.sello %></div>
      <div class="leyenda"><%= f.leyenda %></div>
      <div class="factura-pagina">Página 1 de 1</div>
    </footer>
  </article>
</div>
